      "name": "1. Flujo completo de una reserva",
      "item": [
        {
          "name": "1. Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"qa_{{sufijo}}\",\n  \"email\": \"qa_{{sufijo}}@correo.com\",\n  \"password\": \"Clave123*\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de respuesta es 201\", function () { pm.expect(pm.response.code, \"Cuerpo de la respuesta: \" + pm.response.text().slice(0, 300)).to.eql(201); });",
                  "pm.test(\"Esquema de la respuesta es válido\", function () { pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"success\",\"message\",\"user\"],\"properties\":{\"success\":{\"type\":\"boolean\"},\"message\":{\"type\":\"string\"},\"user\":{\"type\":\"object\",\"required\":[\"id\"]}}}); });",
                  "pm.test(\"Contenido: usuario creado con el nombre enviado\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.be.true;",
                  "  pm.expect(json.message).to.eql(\"User created successfully\");",
                  "  pm.expect(json.user.username).to.eql(\"qa_\" + pm.collectionVariables.get(\"sufijo\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
