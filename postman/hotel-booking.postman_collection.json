  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"sufijo\")) {",
          "  const ahora = Date.now();",
          "  const dia = 24 * 60 * 60 * 1000;",
          "  const formato = function (ms) { return new Date(ms).toISOString().slice(0, 16); };",
          "  pm.collectionVariables.set(\"sufijo\", String(ahora));",
          "  pm.collectionVariables.set(\"telefono\", String(ahora).slice(-8));",
          "  pm.collectionVariables.set(\"fechaEntrada\", formato(ahora + 2 * dia));",
          "  pm.collectionVariables.set(\"fechaSalida\", formato(ahora + 4 * dia));",
          "  pm.collectionVariables.set(\"fechaPasadaEntrada\", formato(ahora - 5 * dia));",
          "  pm.collectionVariables.set(\"fechaPasadaSalida\", formato(ahora - 2 * dia));",
          "}"
        ]
      }
    }
