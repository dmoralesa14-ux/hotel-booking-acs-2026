          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de respuesta es 200\", function () { pm.expect(pm.response.code, \"Cuerpo de la respuesta: \" + pm.response.text().slice(0, 300)).to.eql(200); });",
                  "pm.test(\"Esquema de la respuesta es válido\", function () { pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"id\",\"username\",\"role\"],\"properties\":{\"id\":{\"type\":\"number\"},\"username\":{\"type\":\"string\"},\"role\":{\"type\":\"string\"}}}); });",
                  "pm.test(\"Contenido: usuario correcto, sin contraseña y con cookie de sesión\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.username).to.eql(\"qa_\" + pm.collectionVariables.get(\"sufijo\"));",
                  "  pm.expect(json).to.not.have.property(\"password\");",
                  "  pm.expect(String(pm.response.headers.get(\"Set-Cookie\"))).to.include(\"access_token=\");",
                  "});"
                ]
              }
            }
          ]
        },
